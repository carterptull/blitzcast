DATABASE_URL=postgresql+psycopg://blitzcast:blitzcast@localhost:5432/blitzcast
ODDS_API_KEY=
VISUAL_CROSSING_API_KEY=
ANTHROPIC_API_KEY=
# CollegeFootballData key; every CFB job skips without it
CFBD_API_KEY=
# Claude model used for narration
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Serve fixture predictions (no DB/model needed) for frontend development
BLITZCAST_MOCK=0
# Stamped on ML artifacts and prediction rows, separate from the app version
MODEL_VERSION=1.0.0
MODEL_VERSION_CFB=cfb-1.0.0
