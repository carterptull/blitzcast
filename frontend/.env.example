# Backend API base URL (FastAPI dev server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Buy Me a Beer link — footer button is hidden when unset
NEXT_PUBLIC_BUYMEACOFFEE_URL=

# Set to 1 to serve realistic fixture data (fake 2026 Week 1 slate)
# instead of calling the backend — useful while the API is offline
NEXT_PUBLIC_USE_MOCK=
